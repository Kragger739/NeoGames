# ─────────────────────────────────────────────────────────────────────────────
# NeoGames · Dokploy deployment env
# Paste these into Dokploy → your app → "Environment" (Compose reads them for
# ${VAR} interpolation in docker-compose.yml). Do not commit a filled copy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains ────────────────────────────────────────────────────────────────
# Two sibling subdomains of one registrable domain. Point both A/AAAA records
# at the Dokploy host first, then add them here.
APP_DOMAIN=app.example.com          # the React SPA
API_DOMAIN=api.example.com          # Laravel API + Reverb websockets

# Leading dot → the Sanctum session cookie is shared across both subdomains.
# REQUIRED for this split-domain layout; login breaks without it.
SESSION_DOMAIN=.example.com

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=NeoGames
# Generate once:  docker run --rm laravelphp/php:8.3 -r "echo 'base64:'.base64_encode(random_bytes(32));"
# or after first deploy:  <in Dokploy terminal>  php artisan key:generate --show
APP_KEY=
LOG_LEVEL=warning

# ── Database (the bundled postgres service) ────────────────────────────────
POSTGRES_DB=neogames
POSTGRES_USER=neogames
POSTGRES_PASSWORD=            # long random string

# ── Reverb (websockets) ───────────────────────────────────────────────────
# App-level shared credentials. Any non-empty values that match on both
# sides; the KEY is also baked into the frontend bundle at build time.
#   openssl rand -hex 20   (run three times)
REVERB_APP_ID=neogames
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ── Mail (verification codes, password resets) ────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# ── Social login (optional; leave a pair blank to disable that provider) ──
# Redirect URIs are derived as https://${API_DOMAIN}/api/auth/<provider>/callback
# — register exactly those in the Google / Discord consoles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
