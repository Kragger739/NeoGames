# ─────────────────────────────────────────────────────────────────────────────
# NeoGames · single env file for the Docker Compose stack (Dokploy)
#
# Copy to `.env` for local `docker compose up`, or paste the filled values
# into Dokploy → app → "Environment". Every variable here is consumed by
# docker-compose.yml; nothing else is needed. Do not commit a filled copy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ───────────────────────────────────────────────────────────────────
# ONE public domain for the whole app (SPA + API are same-origin; the
# frontend nginx proxies /api etc. to the backend). DNS A-record it at the
# Dokploy host, then add it in Dokploy → Domains → Service: frontend, Port 80.
APP_DOMAIN=games.example.com

# Optional: only if you also serve the app from other subdomains of a shared
# root. Leave blank for a single domain.
SESSION_DOMAIN=

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=NeoGames
# Must be "base64:" + 32 bytes base64 (44 chars). Generate:
#   php artisan key:generate --show      (or)   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# emergency | alert | critical | error | warning | notice | info | debug
LOG_LEVEL=warning

# ── Postgres (bundled `postgres` service) ────────────────────────────────────
POSTGRES_DB=neogames
POSTGRES_USER=neogames
POSTGRES_PASSWORD=                  # long random string

# ── Reverb (websockets) ─────────────────────────────────────────────────────
# Shared app credentials. APP_KEY is also baked into the frontend bundle at
# build time. Generate each:  openssl rand -hex 20
REVERB_APP_ID=neogames
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ── Mail (verification codes, password resets) ──────────────────────────────
# Cloud hosts almost always block outbound SMTP (25/465/587). Pick one:
#   MAIL_MAILER=log     → code is written to the container logs (default; fine
#                         for testing, not real users)
#   MAIL_MAILER=resend  → HTTPS API on port 443; set RESEND_API_KEY, verify
#                         your sending domain at resend.com
#   MAIL_MAILER=smtp    → only if your host actually allows outbound SMTP
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com

# For MAIL_MAILER=resend
RESEND_API_KEY=

# For MAIL_MAILER=smtp. TLS is on by default: port 465 = implicit TLS,
# any other port = STARTTLS when the server offers it. MAIL_PASSWORD is
# required (SMTP auth). Set MAIL_AUTO_TLS=false only for a local plaintext relay.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Social login (optional — leave a pair blank to disable that provider) ───
# Register these callback URLs in the provider consoles:
#   https://${APP_DOMAIN}/api/auth/google/callback
#   https://${APP_DOMAIN}/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Music (Songle song pool) ───────────────────────────────────────────────
# Spotify supplies song metadata + the popularity score that sets difficulty
# tiers. Create an app at https://developer.spotify.com/dashboard (no redirect
# URI needed - this uses the client-credentials flow). Audio previews come
# from Apple's iTunes Search API, which needs no credentials.
#
# The curated Spotify playlists each genre's pool is seeded from are managed
# in the admin dashboard (Admin -> Song playlists), not here. After adding
# them, hit "Sync now" or run `php artisan songs:sync`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
