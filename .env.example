# ─────────────────────────────────────────────────────────────────────────────
# NeoGames · single env file for the Docker Compose stack (Dokploy)
#
# Copy to `.env` for local `docker compose up`, or paste the filled values
# into Dokploy → app → "Environment". Every variable here is consumed by
# docker-compose.yml; nothing else is needed. Do not commit a filled copy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains ──────────────────────────────────────────────────────────────────
# Two sibling subdomains of one registrable domain, DNS pointed at the host.
APP_DOMAIN=app.example.com          # React SPA
API_DOMAIN=api.example.com          # Laravel API + Reverb websockets

# Leading dot → the Sanctum session cookie is shared across both subdomains.
# Required for this split-domain layout; login fails without it.
SESSION_DOMAIN=.example.com

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=NeoGames
# Generate once:  openssl rand -base64 32   → prefix with "base64:"
# or after first deploy, in the backend container:  php artisan key:generate --show
APP_KEY=
# emergency | alert | critical | error | warning | notice | info | debug
LOG_LEVEL=warning

# ── Postgres (bundled `postgres` service) ────────────────────────────────────
POSTGRES_DB=neogames
POSTGRES_USER=neogames
POSTGRES_PASSWORD=                  # long random string

# ── Reverb (websockets) ─────────────────────────────────────────────────────
# Shared app credentials. APP_KEY is also baked into the frontend bundle at
# build time. Generate each:  openssl rand -hex 20
REVERB_APP_ID=neogames
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ── Mail (verification codes, password resets) ──────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# ── Social login (optional — leave a pair blank to disable that provider) ───
# Redirect URIs are derived as https://${API_DOMAIN}/api/auth/<provider>/callback
# — register exactly those in the Google / Discord consoles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
