# Keep secrets, local state, and history out of the build context / image.
# Dockerfile does `COPY . .`, so anything not excluded here is baked into
# every layer and recoverable from the published image.

.env
.env.*
!.env.example
!.env.production.example

# Local dev database - real users, password hashes, sessions.
database/*.sqlite
database/*.sqlite-journal

.git
.gitignore
.gitattributes
.github

node_modules
vendor

tests
phpunit.xml
.phpunit.result.cache
.phpunit.cache

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/debugbar

*.md
.editorconfig
.styleci.yml
pint.json

Dockerfile
.dockerignore
docker-compose*.yml
